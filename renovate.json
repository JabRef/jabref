{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "prConcurrentLimit": 1,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".jbang/*.java",
        "build-support/src/main/java/*.java",
        "jablib-examples/jbang/*.jbang"
      ],
      "matchStrings": [
        "//DEPS (?<depName>\\S+):(\\${\\S+:(?<currentValue>[^ }]+)})",
        "//DEPS ((?<depName>\\S+:\\S+):(?<currentValue>[^$]\\S+))(\\@\\w+)?"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "matchStrings": [
        "jbang (?<depName>[\\w.-]+:[\\w.-]+):(?<currentValue>[^:\\s]+)(:\\S+)?"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["versions/build.gradle.kts"],
      "matchStrings": ["val jbang = \"(?<currentValue>.+)\""],
      "depNameTemplate": "jbangdev/jbang",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "gradle",
        "gradle-wrapper",
        "github-actions"
      ],
      "enabled": false
    },
    {
      "groupName": "all dependencies",
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "matchDepTypes": ["*"]
    },
    {"allowedVersions": "!/ea/i", "matchPackageNames": ["org.openjfx:{/,}**"]}
  ]
}
