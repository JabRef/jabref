{
    "app-id" : "org.jabref.jabref",
    "runtime" : "org.freedesktop.Platform",
    "runtime-version" : "18.08",
    "sdk" : "org.freedesktop.Sdk",
    "command" : "JabRef",
    "modules" : [
        {
            "name" : "JabRef",
            "buildsystem" : "simple",
            "build-commands" : [
                "tar -xzf JabRef-portable_linux.tar.gz --directory=/app/ --strip-components=1",
                "install -D -m0644 /app/lib/JabRef.png /app/share/icons/hicolor/64x64/apps/org.jabref.jabref.png",
                "install -D -m0644 org.jabref.jabref.desktop /app/share/applications/org.jabref.jabref.desktop"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url": "https://builds.jabref.org/main/linux-amd64/JabRef-portable_linux.tar.gz",
                    "sha256": "53e136e94beb0cb6174788352faf7983750945f5d397e7f6013b8921830b3b59",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type" : "file",
                    "url": "https://builds.jabref.org/main/linux-arm/JabRef-portable_linux_arm64.tar.gz",
                    "sha256": "afa12af2d0e63d3e9016e3a44ea712ce98473222bffd0a94f4d302143a700e58",
                    "dest-filename": "JabRef-portable_linux.tar.gz",
                    "only-arches": [
                        "aarch64"
                    ]
                },
                {
                    "type": "file",
                    "path": "org.jabref.jabref.desktop"
                }
            ]
        }
    ],
    "finish-args" : [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=network",
        "--filesystem=home"
    ]
}
