* \begin{author}\format[AuthorAndsCommaReplacer,LatexToUnicode,MarkdownEscaper,Replace(\x2E$,)]{\author}. \end{author}\begin{url}[\format[LatexToUnicode,MarkdownEscaper,Replace(\x2E$,)]{\title}](<\format[Replace(\x20,%20),Replace(\x3C,%3C),Replace(\x3E,%3E)]{\url}>)\end{url}\begin{!url}\format[LatexToUnicode,MarkdownEscaper,Replace(\x2E$,)]{\title}\end{!url}\format[LatexToUnicode,Replace(\s+, ),Replace(\s+$,),Replace(.*\x3F$,),Replace(.*\x21$,),Replace(.+,.)]{\title}\begin{journal} \format[LatexToUnicode,MarkdownEscaper,Replace(\x2E$,)]{\journal}.\end{journal}\begin{!journal&&booktitle} \format[LatexToUnicode,MarkdownEscaper,Replace(\x2E$,)]{\booktitle}.\end{!journal&&booktitle}\begin{year} \format[Replace(\s+, ),LatexToUnicode,MarkdownEscaper]{\year}\end{year}\begin{pdf} [PDF](<\pdf>)\end{pdf}
