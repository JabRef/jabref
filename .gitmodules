[submodule "abbrv.jabref.org"]
  path = jablib/src/main/abbrv.jabref.org
  url = https://github.com/JabRef/abbrv.jabref.org.git
  ignore = all
  shallow = true
[submodule "csl-styles"]
  path = jablib/src/main/resources/csl-styles
  url = https://github.com/citation-style-language/styles.git
  ignore = all
  shallow = true
[submodule "csl-locales"]
  path = jablib/src/main/resources/csl-locales
  url = https://github.com/citation-style-language/locales.git
  ignore = all
  shallow = true
[submodule "jablib/src/main/resources/ltwa"]
  path = jablib/src/main/resources/ltwa
  url = https://github.com/JabRef/ltwa.git
[submodule "jabgui/themes.jabref.org"]
  path = jabgui/themes.jabref.org
  url = https://github.com/JabRef/themes.jabref.org.git
  shallow = true
  # dirty, not all: CI reformats every *.java, also the submodule's jbang check, but a commit bump must stay visible
  ignore = dirty
