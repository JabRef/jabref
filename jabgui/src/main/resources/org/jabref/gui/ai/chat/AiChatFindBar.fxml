<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.jabref.gui.icon.JabRefIconView?>
<fx:root type="HBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.jabref.gui.ai.chat.AiChatFindBar"
         spacing="4"
         alignment="CENTER"
         maxWidth="-Infinity"
         maxHeight="-Infinity"
         styleClass="bg-secondary,bordered,corner-radius,padding-4-12">
    <TextField fx:id="findField"
               promptText="%Search..."/>
    <Label fx:id="findResultLabel"
           styleClass="text-muted"/>
    <Button fx:id="findPreviousButton"
            onAction="#findPrevious"
            styleClass="icon-button,narrow">
        <graphic>
            <JabRefIconView glyph="PREVIOUS_UP"/>
        </graphic>
        <tooltip>
            <Tooltip text="%Previous"/>
        </tooltip>
    </Button>
    <Button fx:id="findNextButton"
            onAction="#findNext"
            styleClass="icon-button,narrow">
        <graphic>
            <JabRefIconView glyph="NEXT_DOWN"/>
        </graphic>
        <tooltip>
            <Tooltip text="%Next"/>
        </tooltip>
    </Button>
    <Button fx:id="closeFindButton"
            onAction="#closeFind"
            styleClass="icon-button,narrow">
        <graphic>
            <JabRefIconView glyph="CLOSE"/>
        </graphic>
        <tooltip>
            <Tooltip text="%Close"/>
        </tooltip>
    </Button>
</fx:root>
