<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DialogPane fx:id="dialogPane" minWidth="380.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jabref.gui.importer.GenerateEntryFromIdDialog">
   <content>
       <VBox spacing="10.0">
           <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
           </padding>
           <Label text="%Import new entry from ID"/>
           <HBox spacing="10.0">
               <TextField fx:id="idTextField" HBox.hgrow="ALWAYS"/>
               <Button fx:id="generateButton" mnemonicParsing="false" onAction="#generateEntry" textAlignment="CENTER"/>
           </HBox>
       </VBox>
   </content>
</DialogPane>
