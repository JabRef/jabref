<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<DialogPane prefWidth="400" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.jabref.gui.groups.AddToGroupDialog">
    <content>
        <VBox spacing="4">
            <TextField fx:id="searchField" promptText="%Type a group name"/>
            <ListView fx:id="groupList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </content>
</DialogPane>
